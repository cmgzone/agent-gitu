# Copy to .env for local CLI development; existing environment values win.
# Optional credentials stay commented out until you enable the feature.

# Runtime mode used by Node dependencies.
NODE_ENV=development
# Optional direct Android FCM push. Keep the service-account secret out of Git/APK.
# AGENT_GITU_FCM_PROJECT_ID=agent-gitu
# Set either the JSON secret or the credentials file path, not both.
# AGENT_GITU_FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS=/private/gitu-firebase-service-account.json
# HTTP port for `npm start -- ui` or `npm start -- serve`; --port takes precedence.
PORT=8321
# Structured server log verbosity: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Workspace data directory; defaults to ~/AgentGitu.
# AGENT_GITU_HOME=/absolute/path/to/AgentGitu
# Server encryption key: generate 32 random bytes as 64 hex characters; keep stable.
# AGENT_GITU_SECRETS_KEY=replace-with-your-own-64-character-hex-key
# Native/mobile API access key, at least 32 characters; required for remote binding.
# AGENT_GITU_ACCESS_KEY=replace-with-a-random-private-access-key
# Canonical HTTPS origin checked for remote requests.
# AGENT_GITU_PUBLIC_ORIGIN=https://gitu.example.com
# Public base URL for generated links.
# AGENT_GITU_PUBLIC_URL=https://gitu.example.com
# Trust HTTPS headers only from a reverse proxy on this same machine.
# AGENT_GITU_TRUST_LOCAL_PROXY=1
# One-time hosted owner-registration code, at least 32 characters.
# AGENT_GITU_REGISTRATION_TOKEN=replace-with-a-random-private-setup-code
# Pause Telegram polling when another instance owns those bot connections.
# AGENT_GITU_SKIP_TELEGRAM_POLLING=1

# Composio account connection provider; optional for native IMAP/SMTP mailboxes.
# COMPOSIO_API_KEY=replace-with-your-composio-key
# LiveKit project WebSocket URL; all three LiveKit values are required for voice.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LiveKit server API key.
# LIVEKIT_API_KEY=replace-with-your-livekit-key
# LiveKit server API secret.
# LIVEKIT_API_SECRET=replace-with-your-livekit-secret
# Optional LiveKit voice worker name.
# GITU_VOICE_AGENT_NAME=gitu-voice

# Optional private-desktop broker endpoint.
# AGENT_GITU_COMPUTER_BROKER_URL=https://computer.example.com
# Shared private-desktop broker authentication key, at least 32 characters.
# AGENT_GITU_COMPUTER_BROKER_KEY=replace-with-a-random-private-broker-key
# Broker owner identifier; set on the broker deployment.
# AGENT_GITU_COMPUTER_BROKER_OWNER=your-owner-id
# Dedicated Linux filesystem root for desktop quota volumes.
# AGENT_GITU_COMPUTER_QUOTA_ROOT=/var/lib/agent-gitu/computers

# OpenAI provider key; use only the providers you need.
# OPENAI_API_KEY=replace-with-your-openai-key
# Optional OpenAI-compatible API endpoint override.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model override for a custom OpenAI-compatible endpoint.
# OPENAI_MODEL=your-model-id
# Generic custom-provider key; takes precedence over OPENAI_API_KEY for custom mode.
# HERMES_API_KEY=replace-with-your-custom-provider-key
# Custom-provider endpoint override.
# HERMES_BASE_URL=https://your-provider.example.com/v1
# Preferred model ID, also overridable with --model.
# HERMES_MODEL=your-model-id
# Embedding model ID used by semantic memory search.
# HERMES_EMBED_MODEL=text-embedding-3-small
# Provider-specific OpenAI key alias.
# HERMES_OPENAI_API_KEY=replace-with-your-openai-key
# Alibaba Model Studio key.
# DASHSCOPE_API_KEY=replace-with-your-dashscope-key
# Alternative Alibaba key name.
# ALIBABA_API_KEY=replace-with-your-alibaba-key
# Provider-specific Alibaba key alias.
# HERMES_ALIBABA_API_KEY=replace-with-your-alibaba-key
# DeepSeek provider key.
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# Provider-specific DeepSeek key alias.
# HERMES_DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# Gemini provider key.
# GEMINI_API_KEY=replace-with-your-gemini-key
# Alternative Gemini key name.
# GOOGLE_API_KEY=replace-with-your-google-ai-key
# Provider-specific Gemini key alias.
# HERMES_GEMINI_API_KEY=replace-with-your-gemini-key
# OpenRouter provider key.
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
# Provider-specific OpenRouter key alias.
# HERMES_OPENROUTER_API_KEY=replace-with-your-openrouter-key
# OpenCode provider key.
# OPENCODE_API_KEY=replace-with-your-opencode-key
# Provider-specific OpenCode key alias.
# HERMES_OPENCODE_API_KEY=replace-with-your-opencode-key

# Codex runtime executable override; normally discovered automatically.
# GITU_CODEX_PATH=/absolute/path/to/codex
# Legacy name for the Codex executable override.
# HERMES_CODEX_PATH=/absolute/path/to/codex
# Codex-owned configuration directory; normally ~/.codex.
# CODEX_HOME=/absolute/path/to/.codex
# Legacy ChatGPT execution adapter; omit to use the native agent runtime.
# GITU_CHATGPT_EXECUTION_MODE=legacy
# Enable the CLI's optional safe mode.
# HERMES_SAFE_MODE=1
# Legacy workspace-home alias; prefer AGENT_GITU_HOME.
# HERMES_HOME_DIR=/absolute/path/to/AgentGitu
# Legacy home used only when locating older installations.
# HERMES_HOME=/absolute/path/to/legacy-home
# Disable ANSI colors in CLI output when present.
# NO_COLOR=1
# Terminal capability hint inherited from your shell.
# TERM=xterm-256color

# OS-managed values: inherit these instead of copying another machine's paths.
# PATH: executable search path (also inherited as Path on Windows).
# PATHEXT: Windows executable suffixes.
# SYSTEMROOT / SystemRoot / WINDIR: Windows installation directories.
# COMSPEC: Windows command interpreter.
# HOME / USERPROFILE: operating-system user home directory.
# APPDATA / LOCALAPPDATA: Windows application-data directories.
# TEMP / TMP: operating-system temporary directories.
# LANG / LC_ALL: locale inherited by isolated child processes.
# CODEX_INTERNAL_ORIGINATOR_OVERRIDE: internal Codex metadata, not a user setting.
