{
  "name": "agent-gitu",
  "version": "0.1.0",
  "description": "Agent Gitu: an autonomous engineering agent with project guard, task ledger, evidence gates, specialist sub-agents, in-app browser and an animated voxel mascot",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-gitu": "dist/cli.js",
    "hermes": "dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "ui": "node dist/cli.js ui",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hermes": "tsx src/cli.ts",
    "app": "npm run build && electron desktop/main.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
