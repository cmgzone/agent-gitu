{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./apps/mobile/node_modules/@types/react"],
      "react/jsx-runtime": ["./apps/mobile/node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./apps/mobile/node_modules/@types/react/jsx-dev-runtime"],
      "react/*": ["./apps/mobile/node_modules/@types/react/*"]
    }
  },
  "include": ["src/client-astryx/**/*", "src/themes/**/*", "src/astryx-themes.ts"],
  "exclude": ["src/client-astryx/templates/**/*"]
}
